<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <OutputType>Library</OutputType>
    <AssemblyName>PointDynamic</AssemblyName>
    <RootNamespace>PointDynamic</RootNamespace>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!--
    Revit 2025 installs to: C:\Program Files\Autodesk\Revit 2025\
    Adjust the path below if you target a different Revit version.
  -->
  <PropertyGroup>
    <RevitDir>C:\Program Files\Autodesk\Revit 2025</RevitDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>F:\Program Files\Autodesk\Revit 2026\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>F:\Program Files\Autodesk\Revit 2026\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\icon_32.png" />
    <EmbeddedResource Include="Resources\icon_16.png" />
  </ItemGroup>

  <Target Name="DeployAddin" AfterTargets="Build">
    <MakeDir Directories="C:\ProgramData\Autodesk\Revit\Addins\2026" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="C:\ProgramData\Autodesk\Revit\Addins\2026\" />
    <Copy SourceFiles="$(ProjectDir)PointDynamic.addin" DestinationFolder="C:\ProgramData\Autodesk\Revit\Addins\2026\" />
  </Target>

</Project>
